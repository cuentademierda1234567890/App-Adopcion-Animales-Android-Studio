<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/af_root"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvPetNameSimple"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mascota"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvVisitAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dirección de visita"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Elegí un horario disponible"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rgSlots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notas (opcional)"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Observaciones"
            android:inputType="textMultiLine"
            android:layout_marginTop="4dp"/>

        <Button
            android:id="@+id/btnSubmitApplication"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enviar solicitud"
            android:layout_marginTop="12dp"/>

    </LinearLayout>
</ScrollView>
